/* ---- hero: 3D wireframe + particles (canvas, no libraries) ---- */
let heroOn=true;
(()=>{
 const c=$('#fx'),x=c.getContext('2d');let W,H,d=1,P=[],m={x:0,y:0,px:-999,py:-999};
 const phi=(1+Math.sqrt(5))/2,V=[];
 for(const a of[-1,1])for(const b of[-phi,phi]){V.push([0,a,b],[a,b,0],[b,0,a])}
 const E=[];for(let i=0;i<V.length;i++)for(let j=i+1;j<V.length;j++){const dd=Math.hypot(V[i][0]-V[j][0],V[i][1]-V[j][1],V[i][2]-V[j][2]);if(dd<2.1)E.push([i,j])}
 const size=()=>{d=Math.min(devicePixelRatio||1,2);W=c.width=innerWidth*d;H=c.height=(c.offsetHeight||innerHeight)*d;
  const n=Math.min(110,Math.floor(innerWidth/11));P=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4*d,vy:(Math.random()-.5)*.4*d,o:Math.random()<.22}))};
 size();addEventListener('resize',size);
 addEventListener('pointermove',e=>{const r=c.getBoundingClientRect();m.px=(e.clientX-r.left)*d;m.py=(e.clientY-r.top)*d;m.x=e.clientX/innerWidth-.5;m.y=e.clientY/innerHeight-.5});
 let sx=0,sy=0;
 const rot=(v,ax,ay)=>{let[X,Y,Z]=v;let c1=Math.cos(ay),s1=Math.sin(ay),x1=X*c1+Z*s1,z1=-X*s1+Z*c1;let c2=Math.cos(ax),s2=Math.sin(ax);return[x1,Y*c2-z1*s2,Y*s2+z1*c2]};
 const solid=(S,ax,ay,cx,cy,col,ln,dots)=>{
  const pts=V.map(v=>{const r=rot(v,ax,ay),f=4/(r[2]*.45+5);return{x:cx+r[0]*S*f,y:cy+r[1]*S*f,z:r[2]}});
  x.lineWidth=ln*d;
  for(const[i,j]of E){const a=pts[i],b=pts[j],al=.25+.55*((a.z+b.z)/2+phi)/(2*phi);x.strokeStyle=col.replace('A',al.toFixed(2));x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}
  if(dots){x.fillStyle='rgba(255,90,31,.95)';for(const p of pts){x.beginPath();x.arc(p.x,p.y,2.6*d,0,7);x.fill()}}
 };
 const draw=t=>{
  if(heroOn){
   x.clearRect(0,0,W,H);
   for(const p of P){
    const dx=p.x-m.px,dy=p.y-m.py,dist=Math.hypot(dx,dy),R=200*d;
    if(dist<R){const f=(1-dist/R)*.4;p.vx+=dx/dist*f;p.vy+=dy/dist*f}
    p.vx*=.985;p.vy*=.985;p.x+=p.vx;p.y+=p.vy;
    if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;
    x.fillStyle=p.o?'rgba(255,90,31,.85)':'rgba(25,227,208,.7)';x.beginPath();x.arc(p.x,p.y,(p.o?2.1:1.5)*d,0,7);x.fill();
   }
   for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const a=P[i],b=P[j],l=Math.hypot(a.x-b.x,a.y-b.y),L=100*d;if(l<L){x.strokeStyle=`rgba(25,227,208,${.15*(1-l/L)})`;x.lineWidth=d;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}
   sx+=(m.x-sx)*.05;sy+=(m.y-sy)*.05;
   const wide=innerWidth>860,S=Math.min(W,H)*(wide?.17:.13),cx=W*(wide?.74:.5),cy=H*(wide?.5:.22);
   x.globalAlpha=wide?1:.6;
   solid(S,t*.0003+sy*2,t*.0004+sx*2.5,cx,cy,'rgba(25,227,208,A)',1.4,true);
   solid(S*.5,-t*.0005+sy,-t*.0006+sx,cx,cy,'rgba(255,90,31,A)',1.2,false);
   x.globalAlpha=1;
  }
  if(!reduce)requestAnimationFrame(draw);
 };
 draw(0);
})();

/* ---- cursor ---- */
(()=>{
 const cur=$('.cur'),ring=$('.ring');let mx=0,my=0,rx=0,ry=0;
 addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;cur.style.transform=`translate3d(${mx}px,${my}px,0)`});
 (function loop(){rx+=(mx-rx)*.18;ry+=(my-ry)*.18;ring.style.transform=`translate3d(${rx}px,${ry}px,0)`;requestAnimationFrame(loop)})();
 document.addEventListener('pointerover',e=>ring.classList.toggle('big',!!e.target.closest('a,button,input,textarea,.card')));
