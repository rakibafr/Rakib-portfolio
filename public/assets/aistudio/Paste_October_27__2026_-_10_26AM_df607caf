 <button class="card" data-i="${i}" style="animation-delay:${(i%6)*70}ms" aria-label="${p.video?'Play':'Video coming soon:'} ${esc(p.title)}">
  <div class="thumb">
   ${p.thumb?`<img src="${esc(p.thumb)}" alt="" loading="lazy">`:''}
   ${p.preview?`<video src="${esc(p.preview)}" muted loop playsinline preload="none"></video>`:''}
   <span class="play"><b></b></span><span class="type">${esc(p.type)}${p.video?'':' · coming soon'}</span>
  </div>
  <h3>${esc(p.title)}</h3><p>${esc(p.desc)}</p>
 </button>`;
function renderWork(){
 $('#filters').innerHTML=cats.map(c=>`<button data-c="${esc(c)}" aria-pressed="${c===filter}">${esc(c)}</button>`).join('');
 $('#workGrid').innerHTML=PROJECTS.map((p,i)=>[p,i]).filter(([p])=>filter==="All"||p.cat===filter).map(([p,i])=>card(p,i)).join('');
