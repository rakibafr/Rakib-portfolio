  <p class="lead rv">Drag the slider to compare the original footage with the finished shot.</p>
  <div id="bdList"></div>
</div></main>

<!-- PHOTOGRAPHY -->
<main class="page pad" id="photography" data-title="Photography"><div class="wrap">
  <h2 class="rv">Photo<em>graphy</em></h2>
  <div class="mason" id="photoGrid"></div>
</div></main>

<!-- CONTACT -->
<main class="page pad" id="contact" data-title="Contact"><div class="wrap">
  <h2 class="rv">Let’s <em>talk</em></h2>
  <p class="lead rv" id="contactLead"></p>
  <a class="mail rv" id="mailPage"></a>
  <div class="soc rv" id="socials"></div>
  <form id="form" class="rv">
    <label>Your name<input id="fn" required autocomplete="name"></label>
    <label>Message<textarea id="fm" required></textarea></label>
    <button class="btn" type="submit">Send by email</button>
