  const c=e.target.closest('.card');if(!c)return;const p=PROJECTS[c.dataset.i];if(!p.video)return;
  last=c;box.innerHTML=isFile(p.video)?`<video src="${esc(p.video)}" controls autoplay playsinline></video>`:`<iframe src="${esc(p.video)}${p.video.includes('?')?'&':'?'}autoplay=1" allow="autoplay;fullscreen;picture-in-picture" allowfullscreen title="${esc(p.title)}"></iframe>`;
  modal.classList.add('open');$('.x').focus();
 });
});
const modal=$('#modal'),box=$('#box');let last=null;
const closeM=()=>{modal.classList.remove('open');box.innerHTML='';last&&last.focus()};
$('.x').onclick=closeM;modal.onclick=e=>{if(e.target===modal)closeM()};
addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))closeM()});

