  </div></section>
</main>

<!-- ABOUT -->
<main class="page pad" id="about" data-title="About"><div class="wrap about">
  <div>
    <h2 class="rv">About <em>me</em></h2>
    <h3 class="rv">Bio</h3><p class="rv" id="bio"></p>
    <h3 class="rv">Creative approach</h3><p class="rv" id="approach"></p>
    <h3 class="rv">Where I’m heading</h3><div class="goal rv"><p id="goal"></p></div>
