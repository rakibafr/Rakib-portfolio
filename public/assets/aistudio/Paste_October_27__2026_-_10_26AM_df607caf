<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Portfolio</title>
<meta name="description" id="metaDesc" content="">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Oswald:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#07090D;--cy:#19E3D0;--or:#FF5A1F;--tx:#EDEDED;--dim:rgba(237,237,237,.64);--line:rgba(237,237,237,.12)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--tx);font:300 16px/1.65 Inter,system-ui,sans-serif;overflow-x:hidden;cursor:none}
h1,h2,h3,.disp{font-family:Oswald,Impact,sans-serif;text-transform:uppercase;line-height:1}
a,button,input,textarea{cursor:none;color:inherit;text-decoration:none}
button{font:inherit;background:none;border:0}
:focus-visible{outline:2px solid var(--cy);outline-offset:4px}
.page{display:none;min-height:100vh}
.page.on{display:block}
.pad{padding:130px 6vw 100px}
.sec{padding:110px 6vw;border-top:1px solid var(--line)}
.wrap{max-width:1200px;margin:0 auto}
h2{font-size:clamp(40px,6.5vw,92px);margin-bottom:44px}
h2 em{font-style:normal;color:var(--cy)}
.lead{font-size:clamp(18px,2vw,24px);color:var(--dim);max-width:46ch;margin-bottom:40px}
.row{margin-top:44px}

/* grain, scanlines */
body::before{content:"";position:fixed;inset:0;z-index:90;pointer-events:none;opacity:.07;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");animation:grain .6s steps(4) infinite}
body::after{content:"";position:fixed;inset:0;z-index:89;pointer-events:none;opacity:.05;background:repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 3px)}
@keyframes grain{25%{transform:translate(-3%,2%)}50%{transform:translate(2%,-3%)}75%{transform:translate(-2%,-1%)}}

/* cursor */
.cur,.ring{position:fixed;top:0;left:0;z-index:120;pointer-events:none;border-radius:50%;transform:translate3d(-60px,-60px,0)}
.cur{width:6px;height:6px;margin:-3px;background:var(--cy)}
.ring{width:36px;height:36px;margin:-18px;border:1.5px solid var(--or);transition:width .25s,height .25s,margin .25s,background .25s}
.ring.big{width:68px;height:68px;margin:-34px;background:rgba(255,90,31,.12)}
@media(hover:none){body,a,button,input,textarea{cursor:auto}.cur,.ring{display:none}}

/* nav */
nav{position:fixed;inset:0 0 auto 0;z-index:60;display:flex;justify-content:space-between;align-items:center;padding:16px 6vw;backdrop-filter:blur(14px);background:rgba(7,9,13,.6);border-bottom:1px solid var(--line)}
.logo{font:600 22px Oswald;color:var(--cy)}
nav ul{display:flex;gap:26px;list-style:none;font-size:14px}
nav ul a{color:var(--dim);padding:4px 0;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
nav ul a:hover{color:var(--tx)}
nav ul a.act{color:var(--cy);border-color:var(--cy)}
.burger{display:none;font-size:28px;line-height:1}
.btn{display:inline-block;padding:12px 24px;background:var(--or);color:#07090D;font-weight:500;font-size:14px;border-radius:3px;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(255,90,31,.45)}
.btn.ghost{background:none;color:var(--tx);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--cy);box-shadow:none}
@media(max-width:980px){.burger{display:block}nav ul{position:fixed;inset:64px 0 auto 0;flex-direction:column;gap:0;background:var(--bg);padding:8px 6vw 20px;border-bottom:1px solid var(--line);display:none}nav ul.open{display:flex}nav ul a{display:block;padding:14px 0;font-size:18px}}

/* page transition */
#wipe{position:fixed;inset:0;z-index:100;pointer-events:none;display:flex}
#wipe i{flex:1;background:var(--cy);transform:scaleY(0);transform-origin:bottom}
#wipe i:nth-child(even){background:var(--or)}
#wipe.go i{animation:wp .7s cubic-bezier(.7,0,.3,1) both;animation-delay:calc(var(--n)*45ms)}
@keyframes wp{0%{transform:scaleY(0);transform-origin:bottom}45%{transform:scaleY(1);transform-origin:bottom}55%{transform:scaleY(1);transform-origin:top}100%{transform:scaleY(0);transform-origin:top}}

/* reveal */
.rv{clip-path:inset(0 0 100% 0);transform:translateY(28px);transition:clip-path .9s cubic-bezier(.2,.8,.2,1),transform .9s cubic-bezier(.2,.8,.2,1)}
.rv.in{clip-path:inset(0 0 -20% 0);transform:none}

/* hero */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden}
#fx{position:absolute;inset:0;width:100%;height:100%}
.hero .wrap{position:relative;z-index:2;width:100%;padding:130px 6vw 80px;pointer-events:none}
.hero .wrap a{pointer-events:auto}
.name{font-size:clamp(52px,12vw,180px);font-weight:600;line-height:.92}
.name .ch{display:inline-block;opacity:0;transform:translateY(40px) skewX(-8deg);filter:blur(10px);animation:chIn .8s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:calc(var(--i)*55ms + .3s)}
.name .gap{display:inline-block;width:.25em}
@keyframes chIn{60%{text-shadow:-6px 0 var(--cy),6px 0 var(--or)}to{opacity:1;transform:none;filter:none;text-shadow:none}}
.name.glitch{animation:gl .35s steps(2) 1}
@keyframes gl{20%{text-shadow:-5px 0 var(--cy),5px 0 var(--or);transform:translateX(3px)}60%{text-shadow:4px 0 var(--cy),-4px 0 var(--or);transform:translateX(-3px)}}
.sub{margin-top:24px;font:400 clamp(15px,2vw,24px) Oswald;letter-spacing:.22em;text-transform:uppercase;color:var(--cy);opacity:0;animation:fade 1s 1.6s forwards}
.tag{margin-top:14px;max-width:520px;color:var(--dim);opacity:0;animation:fade 1s 1.9s forwards}
.cta{margin-top:34px;display:flex;gap:14px;flex-wrap:wrap;opacity:0;animation:fade 1s 2.2s forwards}
@keyframes fade{to{opacity:1}}
.hint{position:absolute;bottom:28px;left:6vw;z-index:2;font-size:12px;letter-spacing:.2em;color:var(--dim);display:flex;gap:14px;align-items:center}
.hint i{width:60px;height:1px;background:var(--or);transform-origin:left;animation:ln 2s ease-in-out infinite}
@keyframes ln{50%{transform:scaleX(.2)}}

/* intro / chips */
.intro{display:grid;grid-template-columns:1fr 1.3fr;gap:60px;align-items:start}
@media(max-width:860px){.intro{grid-template-columns:1fr;gap:28px}}
.intro p{color:var(--dim);font-size:18px;max-width:56ch;margin-bottom:28px}
.chips{display:flex;flex-wrap:wrap;gap:12px}
.chips span{padding:10px 20px;border:1px solid var(--line);border-radius:30px;font:400 15px Oswald;letter-spacing:.08em;text-transform:uppercase;transition:.3s}
.chips span:hover{border-color:var(--cy);color:var(--cy);box-shadow:0 0 24px rgba(25,227,208,.25)}

/* about */
.about{display:grid;grid-template-columns:1.2fr 1fr;gap:80px}
@media(max-width:900px){.about{grid-template-columns:1fr;gap:56px}}
.about h3{font-size:24px;color:var(--cy);margin-bottom:12px}
.about p{color:var(--dim);margin-bottom:36px;max-width:60ch}
.goal{border-left:2px solid var(--or);padding-left:22px}
.goal p{color:var(--tx);margin:0}
.tl{position:relative;padding-left:28px}
.tl::before{content:"";position:absolute;left:0;top:6px;bottom:6px;width:1px;background:linear-gradient(var(--cy),var(--or));transform-origin:top;transform:scaleY(var(--p,0))}
.tl div{position:relative;margin-bottom:30px}
.tl div::before{content:"";position:absolute;left:-32px;top:8px;width:9px;height:9px;border-radius:50%;background:var(--bg);border:1.5px solid var(--cy)}
.tl small{color:var(--or);font-size:13px}
.tl h4{font-weight:500;font-size:16px}
.tl span{color:var(--dim);font-size:14px;display:block}

/* work cards */
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:40px}
.filters button{padding:8px 18px;border:1px solid var(--line);border-radius:30px;font-size:13px;transition:.25s}
.filters button:hover{border-color:var(--cy)}
.filters button[aria-pressed=true]{background:var(--cy);color:#07090D;border-color:var(--cy)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:32px}
@media(max-width:400px){.grid{grid-template-columns:1fr}}
.card{text-align:left;display:block;width:100%;animation:pop .6s both}
@keyframes pop{from{opacity:0;transform:translateY(20px)}}
.thumb{aspect-ratio:16/9;position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--line);background:#0c1117;transition:border-color .3s,box-shadow .3s}
.thumb::before{content:"";position:absolute;inset:-50%;background:conic-gradient(transparent,rgba(25,227,208,.28),transparent 40%,rgba(255,90,31,.25),transparent 80%);animation:spin 8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.thumb img,.thumb video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s}
.card:hover .thumb{border-color:var(--cy);box-shadow:0 0 0 1px var(--cy),0 0 40px rgba(25,227,208,.25)}
.card:hover .thumb img,.card:hover .thumb video{transform:scale(1.06)}
.play{position:absolute;inset:0;display:grid;place-items:center;z-index:2}
.play b{width:60px;height:60px;border-radius:50%;border:1.5px solid var(--tx);display:grid;place-items:center;transition:.3s}
.play b::after{content:"";border-left:13px solid var(--tx);border-top:8px solid transparent;border-bottom:8px solid transparent;margin-left:4px}
.card:hover .play b{border-color:var(--or);background:var(--or);transform:scale(1.1)}
.type{position:absolute;right:12px;bottom:12px;z-index:2;font-size:11px;padding:3px 9px;background:rgba(7,9,13,.75);border:1px solid var(--line);border-radius:20px}
.card h3{font-size:22px;margin:16px 0 6px}
.card p{color:var(--dim);font-size:14px}

/* skills */
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px}
.sk{padding:28px;border:1px solid var(--line);border-radius:8px;position:relative;overflow:hidden;transition:border-color .3s}
.sk::before{content:"";position:absolute;top:0;left:0;height:2px;width:100%;background:linear-gradient(90deg,var(--cy),var(--or));transform:scaleX(0);transform-origin:left;transition:transform .9s .2s}
.sk.in::before{transform:scaleX(1)}
.sk::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(25,227,208,.14),transparent);transform:skewX(-20deg);transition:left .8s}
.sk:hover{border-color:var(--cy)}
.sk:hover::after{left:130%}
.sk h3{font-size:21px;margin-bottom:10px}
.sk p{color:var(--dim);font-size:14px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px}
.col{border-top:1px solid var(--cy);padding-top:18px}
.col:nth-child(2){border-color:var(--or)}
.col h3{font-size:20px;margin-bottom:12px}
.col li{list-style:none;color:var(--dim);font-size:15px;padding:5px 0}

/* breakdown slider */
.bd{margin-bottom:64px;max-width:980px}
.bd h3{font-size:26px;margin:18px 0 6px}
.bd p{color:var(--dim);font-size:14px}
.stage{position:relative;aspect-ratio:16/8;border-radius:8px;overflow:hidden;border:1px solid var(--line);user-select:none;touch-action:pan-y;background:#0c1117}
.lay{position:absolute;inset:0;display:grid;place-items:center}
.lay img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lay.a{clip-path:inset(0 0 0 var(--x,50%))}
.lay.b{background:linear-gradient(#3a3d42,#23262b);filter:grayscale(1)}
.lay.a{background:radial-gradient(ellipse at 50% 110%,rgba(255,90,31,.45),transparent 60%),linear-gradient(#0a1a22,#07090D)}
.orb{width:32%;aspect-ratio:1;border-radius:50%}
.b .orb{background:radial-gradient(circle at 35% 35%,#777,#444)}
.a .orb{background:radial-gradient(circle at 35% 30%,#fff,var(--cy) 30%,#0a4d52 70%);box-shadow:0 0 80px 10px rgba(25,227,208,.55),0 0 160px 40px rgba(255,90,31,.25)}
.handle{position:absolute;top:0;bottom:0;left:var(--x,50%);width:2px;background:var(--or);z-index:3;pointer-events:none;box-shadow:0 0 18px var(--or)}
.handle::after{content:"↔";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;background:var(--or);color:#07090D;display:grid;place-items:center;font-size:18px}
.stage input{position:absolute;inset:0;width:100%;height:100%;opacity:0;z-index:4;padding:0;border:0}
.lbl{position:absolute;top:14px;font-size:11px;letter-spacing:.15em;z-index:2;padding:3px 9px;background:rgba(7,9,13,.7);border-radius:3px}

/* photos */
.mason{columns:3 280px;column-gap:20px}
.ph{break-inside:avoid;margin-bottom:20px;position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--line);background:linear-gradient(135deg,#0d141b,#121a22)}
.ph img{width:100%;display:block;transition:transform .8s}
.ph:hover img{transform:scale(1.05)}
.ph figcaption{position:absolute;inset:auto 0 0 0;padding:40px 18px 16px;background:linear-gradient(transparent,rgba(7,9,13,.9));opacity:.85;transition:.4s}
.ph:hover figcaption{opacity:1}
.ph h3{font-size:20px;color:var(--cy)}
.ph small{color:var(--dim);font-size:12px}

/* contact */
.mail{display:inline-block;font:400 clamp(22px,4.5vw,56px) Oswald;color:var(--or);border-bottom:1px solid var(--or);padding-bottom:4px;word-break:break-all;transition:color .2s,border-color .2s}
.mail:hover{color:var(--cy);border-color:var(--cy)}
.soc{display:flex;gap:22px;flex-wrap:wrap;margin-top:28px}
.soc a{color:var(--dim);border-bottom:1px solid var(--line);transition:.2s}
.soc a:hover{color:var(--cy);border-color:var(--cy)}
form{margin-top:50px;display:grid;gap:16px;max-width:560px}
label{font-size:13px;color:var(--dim);display:grid;gap:6px}
input,textarea{background:rgba(237,237,237,.04);border:1px solid var(--line);border-radius:4px;padding:12px 14px;font:inherit;color:var(--tx);transition:border-color .2s}
input:focus,textarea:focus{outline:0;border-color:var(--cy)}
textarea{min-height:130px;resize:vertical}
form .btn{justify-self:start}
.quote{font:600 clamp(24px,4vw,48px) Oswald;text-transform:uppercase;line-height:1.1;max-width:18em;color:var(--dim);margin-top:100px}
footer{padding:30px 6vw 40px;text-align:center;color:var(--dim);font-size:12px;border-top:1px solid var(--line)}

/* modal */
#modal{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.92);display:none;place-items:center;padding:20px}
#modal.open{display:grid}
#box{width:min(1100px,100%);aspect-ratio:16/9;background:#000}
#box iframe,#box video{width:100%;height:100%;border:0}
.x{position:absolute;top:16px;right:24px;font-size:38px}

@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
 .name .ch,.sub,.tag,.cta{opacity:1;transform:none;filter:none}
 .rv{clip-path:none;transform:none}.tl::before,.sk::before{transform:none}
}
</style>
</head>
