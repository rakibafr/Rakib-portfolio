/* ---- reveals + timeline ---- */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
const tl=$('#tl');
const upd=()=>{const r=tl.getBoundingClientRect();tl.style.setProperty('--p',Math.max(0,Math.min(1,(innerHeight*.8-r.top)/r.height)))};
addEventListener('scroll',upd,{passive:true});

/* ---- router ---- */
let current=null,first=true;
function show(){
 const r=location.hash.replace(/^#\/?/,'')||'home';
 const id=routes.some(([k])=>k===r)?r:'home';
 if(id===current)return;
 const swap=()=>{
  $$('.page').forEach(p=>p.classList.toggle('on',p.id===id));
  $$('#menu a').forEach(a=>a.classList.toggle('act',a.dataset.r===id));
  const t=$('#'+id).dataset.title;document.title=SITE.name+(t?' – '+t:' – '+SITE.role.split("·")[0].trim());
  heroOn=id==='home';current=id;scrollTo({top:0,behavior:'instant'});
  $$('#'+id+' .rv').forEach(el=>{el.classList.remove('in');io.observe(el)});
  upd();$('#menu').classList.remove('open');$('#burger').setAttribute('aria-expanded','false');
 };
 if(first||reduce){first=false;swap();return}
 const w=$('#wipe');w.classList.remove('go');void w.offsetWidth;w.classList.add('go');setTimeout(swap,330);
}
addEventListener('hashchange',show);show();
$('#burger').addEventListener('click',()=>{const o=$('#menu').classList.toggle('open');$('#burger').setAttribute('aria-expanded',o)});
</script>
