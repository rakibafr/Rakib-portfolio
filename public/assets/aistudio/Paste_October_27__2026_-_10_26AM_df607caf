  email:"you@example.com",
  location:"Your City",
  intro:"Write two or three sentences about who you are and what you make. This shows on the home page.",
  bio:"Write your longer story here: where you are from, how you started, what drives you.",
  approach:"Describe how you work and what you want your audience to feel.",
  goal:"I direct, shoot, edit, design motion graphics, write scripts and generate AI video. All of it feeds one goal: working as a VFX artist in the film industry.",
  contactLead:"Open to film projects, collaborations and VFX opportunities.",
  closing:"Add a quote or closing line that sums up how you think.",
  socials:[ /* {label:"Instagram",url:"https://instagram.com/you"}, {label:"Vimeo",url:"https://vimeo.com/you"} */ ]
};
const EDUCATION=[
  {years:"2020 – 2023",school:"School or course name",detail:"Degree, certificate or what you studied"},
  {years:"2016 – 2020",school:"Another school",detail:"What you studied"}
];
const SKILLS=[
  {t:"Direction",d:"Concept, storyboards and moodboards through to the final cut."},
  {t:"Cinematography",d:"Camera, light and composition with intention."},
  {t:"Video editing",d:"Rhythm and pacing that carry the emotion."},
